<script>
/* Test-hulp: als de URL ?soft=0/1 bevat, die param sticky maken op interne links (klik-tijd, dus
   ook op lazy-geladen kaarten). Doet niets zonder ?soft in de URL -> raakt echte (geo) bezoekers niet. */
(function(){
  var m = (location.search || '').match(/[?&]soft=([01])(?:&|$)/);
  if (!m) return; var val = m[1];
  document.addEventListener('click', function(ev){
    var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
    if (!a) return;
    var href = a.getAttribute('href') || '';
    if (href.charAt(0) !== '/' || /[?&]soft=/.test(href)) return;   // alleen interne links zonder soft-param
    var hash = '', hi = href.indexOf('#');
    if (hi !== -1) { hash = href.slice(hi); href = href.slice(0, hi); }
    a.setAttribute('href', href + (href.indexOf('?') === -1 ? '?' : '&') + 'soft=' + val + hash);
  }, true);
})();
</script>
