# YomiHub-Project – .gitignore (0.4.4, 29/10/2026)

# ── Secrets: never commit ──
*.jks
*.keystore
*.p12
*.pfx
keystore-password.txt
key.properties
**/key.properties
**/*cookie*.txt
**/cookies.json
.env

# ── Scraped site data (contains cookies / third-party pages) ──
/fetch/

# ── Build outputs, installers, logs, job queues ──
/output/
/logs/
/jobs/
**/build/
# 18/11/2026: thu muc build/ o goc chua cac script build_*.ps1 (khong phai thu muc dung Flutter)
!/build/
**/.dart_tool/
**/.gradle/
**/.kotlin/
**/ephemeral/
*.apk
*.aab
*.exe
*.dll
*.so
*.zip
*.tgz
*.tar
*.gz
*.7z
*.bundle
*.appx
*.appxbundle
*.msix
*.cer
*.mp4
*.log

# ── QA evidence, screenshots, pre-change copies (kept on the build PC) ──
/test/
/Screenshot/

# ── Audit directory ignore rules ──
audit/**/before/
audit/**/test-tools/
audit/**/compat23/
audit/**/*.png
audit/**/*.jpg
audit/**/*.jpeg
audit/**/*.webp
audit/**/*.xml
audit/**/*.mp4
audit/**/*.jar
audit/**/iptproxy/
audit/**/_scratch/
audit/**/hako_repo/
audit/**/vtv_*.html
audit/**/npm/
audit/**/backup/
audit/**/*.html
audit/**/qa/
audit/**/fetch/
audit/**/before_scripts/
audit/**/yomi_ls*
audit/**/__pycache__/
audit/**/extracted_backup/
audit/**/*.backup
audit/**/*.backup.db
audit/**/extracted_requirements.txt
audit/**/inputs/
audit/**/jobsrc/
audit/**/status/
audit/audit-0.5.5/*.ps1
audit/**/evidence/*
!audit/**/evidence/QA2/
audit/**/evidence/QA2/*
!audit/**/evidence/QA2/RESULTS_QA2.md
audit/**/vpn/apk/
audit/**/vpn/evidence/
audit/**/android6/evidence/
audit/**/android6/evidence57/
audit/**/android6/work/
audit/**/android6/out/
audit/**/android6/orig_libisar/
audit/**/android6/patched_libisar/
audit/**/android6/patched_libtor/
audit/**/android6/tmp/
audit/**/evidence/
audit/**/devbuild/

# ── Large prebuilt upstream binaries for iOS/macOS (not YomiHub targets, >40 MB) ──
**/ios/Frameworks/
**/macos/Frameworks/
*.dylib

# ── Needed to build the app: keep despite the binary rules above ──
!**/jniLibs/**/*.so
!**/assets/mangayomi_mpv.zip
!**/res/raw/*.mp4

# third-party source trees downloaded for reference (414 MB, not YomiHub code)
/dev/x018/ref/
/_to_delete/
/ocr_check.ps1
/find_imported.ps1
/find_xml.ps1
/sync_054.ps1
src/mangayomi-0.9.95/

# 0.5.9: OAuth client config (injected at build via --dart-define)
secrets/
